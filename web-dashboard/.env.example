# Browser-safe Supabase values. Never put service-role or provider secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only protected API values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Server-only ingestion worker values.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Optional local Vite proxy override.
AMZ_API_PROXY_TARGET=http://127.0.0.1:8787
