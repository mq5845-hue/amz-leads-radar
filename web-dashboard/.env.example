# Browser-safe Supabase values. Never put service-role or provider secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only protected API values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Server-only ingestion worker values.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Optional local Vite proxy override.
AMZ_API_PROXY_TARGET=http://127.0.0.1:8787

# Optional local live Auth smoke inputs. Keep these in the shell environment or
# an ignored local env file; never commit a real password or access token.
AMZ_SMOKE_SUPABASE_URL=https://your-project.supabase.co
AMZ_SMOKE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
AMZ_SMOKE_EMAIL=dedicated-smoke-user@example.com
AMZ_SMOKE_PASSWORD=
AMZ_PRODUCTION_API_URL=https://your-production-domain.example/api/review-drafts
AMZ_SMOKE_ALLOW_QUOTA_DECREMENT=0
AMZ_SMOKE_RUN_PRODUCTION_API=0
